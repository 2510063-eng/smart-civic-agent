# CivicResolve AI Configuration
APP_NAME=CivicResolve AI
ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./civic_resolve.db

# AI Agent Configuration
# Optional: Google Gemini API key for advanced multimodal reasoning
# If not provided, CivicResolve AI automatically utilizes its built-in rule/NLP heuristics engine.
GEMINI_API_KEY=

# Security
SECRET_KEY=civic-resolve-hackathon-secret-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=./uploads
